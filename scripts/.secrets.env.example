# Copy this file to .secrets.env (git-ignored) and fill in your values.
# NEVER commit .secrets.env.

# Buff163 logged-in session cookie.
# Get it: log in at buff.163.com -> DevTools -> Application -> Cookies
#         -> buff.163.com -> copy the "session" value.
BUFF_COOKIE="session=YOUR_SESSION_VALUE_HERE"

# Optional: CSFloat API key (profile -> Developer tab). Only needed if you
# enable csfloat in ACTIVE_SOURCES.
# CSFLOAT_API_KEY="your-key"

# Optional overrides:
# REFRESH_SECONDS=60
# ACTIVE_SOURCES=buff163,youpin898

# Steam login cookies — needed for the Trade Link checker's trade-window view
# (shows items that public inventories hide for ~10 days after a trade).
# Get them: log in at steamcommunity.com -> DevTools -> Application -> Cookies
#           -> https://steamcommunity.com -> copy the two values below.
# STEAM_SESSIONID="your-sessionid"
# STEAM_LOGIN_SECURE="your-steamLoginSecure"
